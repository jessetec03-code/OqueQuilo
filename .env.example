# Copie este arquivo para ".env" (sem o .example) e preencha se quiser.
# O arquivo .env NUNCA vai para o GitHub (está no .gitignore).

# Motor de reconhecimento de alimentos:
#   auto   = YOLOE local se instalado (requirements-visao.txt); senão Claude (se houver chave); senão manual
#   local  = só o YOLOE local      claude = só o Claude      manual = sem reconhecimento automático
MOTOR_VISAO=auto

# Modelo do YOLOE (baixado automaticamente no 1º uso para data/modelos/)
YOLOE_MODELO=yoloe-v8l-seg.pt

# Opcional e pago: reconhecimento pelo Claude (Anthropic). Precisa de requirements-ia.txt.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Porta do servidor
PORTA=8000

# Endereço usado nos QR Codes. Deixe vazio para usar o IP deste computador na rede local.
# Exemplo: URL_PUBLICA=http://192.168.0.15:8000
URL_PUBLICA=
